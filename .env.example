PORT=3000
APP_BASE_URL=http://localhost:3000
JWT_SECRET=replace_with_a_strong_random_secret

# MoMo payment configuration.
# Leave these empty if you only want to test cash payments.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_REDIRECT_URL=http://localhost:3000/api/payments/momo/return
MOMO_IPN_URL=http://localhost:3000/api/payments/momo/ipn
MOMO_REQUEST_TYPE=captureWallet
